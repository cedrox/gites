layout: 
---

<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in site.pages %}
  {% if page.url contains '.xml' or page.url contains 'assets' or page.url contains '.txt' or page.url == '/404.html' %}{% else %}
      <url>
        <loc>{{ site.url }}{{ page.url }}</loc>
        <lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod>
        <changefreq>monthly</changefreq>
        {% if page.url == "/" %}<priority>1.0</priority>
        {% elsif page.categories contains "gites" %}<priority>0.9</priority>
        {% else %}<priority>0.7</priority>
        {% endif %}
       </url>
  {% endif %}
  {% endfor %}
  {% for page in site.posts %}
      <url>
        <loc>{{ site.url }}{{ page.url | replace: 'index.html', '' }}</loc>
        <lastmod>{{ page.date | date: "%Y-%m-%d" }}</lastmod>
        <changefreq>monthly</changefreq>
        <priority>0.8</priority>
       </url>
  {% endfor %}
</urlset>